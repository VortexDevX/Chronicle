{
  "name": "chronicle",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "icons:export": "node scripts/export-brand-icons.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "cron:check": "tsx --env-file=.env scripts/checkCron.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "animejs": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.14.0",
    "mongoose": "^8.24.10",
    "next": "^16.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.6.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.33"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.13.0": true
  }
}
