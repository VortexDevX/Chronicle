# Required
MONGODB_URI=mongodb://localhost:27017/chronicle
JWT_SECRET=your-32-char-secret-here

# CORS + reset links — comma-separated allowed origins. First origin is used for email reset links.
APP_ORIGIN=https://chroniclex.vercel.app

# Optional public URL fallback for metadata when no request host is available.
NEXT_PUBLIC_APP_URL=https://chroniclex.vercel.app

# Optional search-engine ownership verification tokens (public in page metadata).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Password reset email (Brevo Transactional API)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_FROM_EMAIL=no-reply@your-domain.com
BREVO_FROM_NAME=Chronicle

# Cron protection (required in production)
CRON_SECRET=your-cron-secret-here
CRON_CHECK_CONCURRENCY=4
CRON_TIME_BUDGET_MS=24000
CRON_SCRAPE_RETRIES=2

# Telegram notifications (global fallback)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-her

# Android push notifications (Firebase Cloud Messaging HTTP v1)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
